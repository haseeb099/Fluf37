# Paid pilot profile — copy to .env for external design partners
# See docs/GTM_LAUNCH.md and docs/security-compliance.md

NEXUS_DEMO_MODE=true
NEXUS_PRE_LIVE_MODE=true
NEXUS_TRUST_CLIENT_ROLE=false

AUTH_MODE=jwt_required
NEXUS_WS_REQUIRE_AUTH=true

# ROTATE ALL SECRETS BEFORE SHARING WITH A CUSTOMER
NEXUS_API_KEY=replace-with-rotated-key
JWT_SECRET=replace-with-rotated-secret-min-32-chars
INGEST_HMAC_SECRET_CRM=replace-crm-hmac
INGEST_HMAC_SECRET_BANK=replace-bank-hmac
INGEST_HMAC_SECRET_ERP=replace-erp-hmac

CORS_ORIGINS=https://your-frontend.example.com

# Optional: first live connector (beta path)
# NEXUS_DEMO_MODE=false
# NEXUS_ENABLE_BANK=true
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
