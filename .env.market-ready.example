# Nexus AI — Market-ready profile (live LLM + structured demo data)
# Copy to .env and paste your provider API key when your LLM lead shares credentials.
#
#   copy .env.market-ready.example .env
#   # Edit ANTHROPIC_API_KEY or OPENAI_API_KEY
#   python scripts/generate_demo_data.py --seed 42
#   uvicorn backend.main:app --reload --port 8000

NEXUS_DEMO_MODE=true
NEXUS_LIVE_LLM=true
NEXUS_PRE_LIVE_MODE=false
NEXUS_TRUST_CLIENT_ROLE=true
NEXUS_API_KEY=demo-key
NEXUS_DEMO_SEED=42

# Provider — Groq (OpenAI-compatible). Paste your key from console.groq.com
LLM_PROVIDER=groq
NEXUS_LIVE_LLM=true
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides (defaults in backend/config.py)
# PRIMARY_MODEL=claude-sonnet-4-20250514
# FALLBACK_MODEL=gpt-4o

AUTH_MODE=jwt_optional
JWT_SECRET=change-me-in-production
NEXUS_WS_REQUIRE_AUTH=false

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/nexus/stream
NEXT_PUBLIC_NEXUS_API_KEY=demo-key

# Connectors stay on deterministic demo JSON until live vendors are wired
NEXUS_ENABLED_CONNECTORS=crm,erp,bank,trading,news
NEXUS_ENABLE_CRM=false
NEXUS_ENABLE_ERP=false
NEXUS_ENABLE_BANK=false
NEXUS_ENABLE_TRADING=false
NEXUS_ENABLE_NEWS=false
