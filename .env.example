# Nexus AI — Environment Configuration
NEXUS_DEMO_MODE=true
NEXUS_API_KEY=demo-key
NEXUS_DEMO_SEED=42

# LLM (optional in demo mode)
ANTHROPIC_API_KEY=demo
OPENAI_API_KEY=demo

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=60
AUTH_MODE=jwt_optional
NEXUS_WS_REQUIRE_AUTH=false
NEXUS_RATE_LIMIT_PER_MINUTE=60
NEXUS_RATE_LIMIT_DEMO_PER_MINUTE=600
LLM_PROVIDER=anthropic
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Connectors (enable live integrations)
NEXUS_ENABLED_CONNECTORS=crm,erp,bank,trading,news
NEXUS_ENABLE_CRM=false
NEXUS_ENABLE_ERP=false
NEXUS_ENABLE_BANK=false
NEXUS_ENABLE_TRADING=false
NEXUS_ENABLE_NEWS=false

# Ingest webhooks
INGEST_HMAC_SECRET_CRM=demo-crm-secret
INGEST_HMAC_SECRET_BANK=demo-bank-secret
INGEST_HMAC_SECRET_ERP=demo-erp-secret

# Plaid
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Alpaca
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Salesforce / HubSpot
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
HUBSPOT_API_KEY=

# ERP
NETSUITE_ACCOUNT_ID=
QUICKBOOKS_CLIENT_ID=

# Memory paths
VECTOR_DB_PATH=./data/chroma
GRAPH_DB_PATH=./data/graph.json
SQLITE_PATH=./data/nexus.db

# Backend URL (frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/nexus/stream
NEXT_PUBLIC_NEXUS_API_KEY=demo-key
